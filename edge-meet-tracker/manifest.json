
{
  "manifest_version": 3,
  "name": "CLASSFLOW Meet Tracker",
  "version": "1.0.0",
  "description": "Tracks Google Meet page activity for CLASSFLOW.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:8082/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CLASSFLOW Meet Tracker"
  }
}
